{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphMemoryInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "zh-Hans",
        "en",
        "ja"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "segment_id",
          "ordinal",
          "text"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "language",
    "segments"
  ]
}
